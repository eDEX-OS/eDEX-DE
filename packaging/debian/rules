#!/usr/bin/make -f
export CARGO_HOME=$(CURDIR)/debian/cargo-home

%:
	dh $@

override_dh_auto_build:
	cargo build --release --locked --workspace --bins
	assets/make-assets.sh assets/generated

override_dh_auto_test:
	cargo test --release --locked --workspace

override_dh_auto_install:
	install -Dm755 target/release/edex-de debian/edex-de/usr/bin/edex-de
	install -Dm755 target/release/edex-greeter debian/edex-de/usr/bin/edex-greeter
	install -Dm755 packaging/session/edex-session debian/edex-de/usr/bin/edex-session
	install -Dm755 packaging/greetd/edex-greeter-session debian/edex-de/usr/bin/edex-greeter-session
	install -Dm644 packaging/session/edex-de.desktop debian/edex-de/usr/share/wayland-sessions/edex-de.desktop
	install -Dm644 -t debian/edex-de/usr/share/applications packaging/applications/*.desktop
	install -Dm644 packaging/session/edex-de-portals.conf debian/edex-de/usr/share/xdg-desktop-portal/edex-de-portals.conf
	install -Dm644 packaging/systemd/edex-de.service debian/edex-de/usr/lib/systemd/user/edex-de.service
	install -Dm644 packaging/tmpfiles/edex-greeter.conf debian/edex-de/usr/lib/tmpfiles.d/edex-greeter.conf
	install -Dm644 packaging/polkit/50-edex-greeter-power.rules debian/edex-de/usr/share/polkit-1/rules.d/50-edex-greeter-power.rules
	install -Dm644 packaging/greeter/greeter.toml debian/edex-de/etc/edex-greeter/greeter.toml
	install -Dm644 packaging/greetd/config.toml debian/edex-de/usr/share/edex-de/greetd/config.toml
	install -Dm644 share/skel/hyprland.lua debian/edex-de/etc/skel/.config/hypr/hyprland.lua
	install -dm755 debian/edex-de/usr/share/edex-de/themes debian/edex-de/usr/share/edex-de/hypr debian/edex-de/usr/share/edex-de/backgrounds
	install -m644 themes/*.toml debian/edex-de/usr/share/edex-de/themes/
	cp -r share/hypr/. debian/edex-de/usr/share/edex-de/hypr/
	install -m644 assets/generated/backgrounds/*.png debian/edex-de/usr/share/edex-de/backgrounds/
	for s in 32 48 64 128 256 512; do install -Dm644 assets/generated/icons/edex-de-$$s.png debian/edex-de/usr/share/icons/hicolor/$${s}x$${s}/apps/edex-de.png; done
	install -Dm644 assets/logo.svg debian/edex-de/usr/share/icons/hicolor/scalable/apps/edex-de.svg

override_dh_dwz:
override_dh_strip:
	dh_strip --no-automatic-dbgsym
